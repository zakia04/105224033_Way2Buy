# ==============================================================================
# Way2Buy — Environment Variables Template (.env.example)
# ==============================================================================
# PERINGATAN KEAMANAN:
# Jangan pernah menambahkan kunci privat, token, password, atau secret asli
# ke file ini atau melakukan commit file .env.local ke repository Git.
#
# CARA PENGGUNAAN:
# 1. Salin file ini menjadi .env.local:
#    cp .env.example .env.local
# 2. Bangkitkan kunci simetris 256-bit (32 byte) acak melalui Node.js CSPRNG:
#    node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 3. Tempelkan string Base64 yang dihasilkan ke variabel WAY2BUY_ENCRYPTION_KEY di .env.local.
# ==============================================================================

# Kunci Enkripsi Simetris AES-256-GCM (Panjang wajib: 32 byte ter-encode Base64)
# Contoh nilai sintetis/dummy (BUKAN kunci produksi):
WAY2BUY_ENCRYPTION_KEY=DUMMY_SYNTHETIC_KEY_BASE64_PLACEHOLDER_32BYTES_ONLY==
